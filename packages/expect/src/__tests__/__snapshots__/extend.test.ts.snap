<d>  }</>
`;

exports[`defines asymmetric unary matchers that can be prefixed by not 1`] = `
<d>expect(</><r>received</><d>).</>toEqual<d>(</><g>expected</><d>) // deep equality</>

<g>- Expected  - 1</>
<r>+ Received  + 1</>

